{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "todowrite": "allow",
    "bash": {
      "*": "allow",
      "curl *": "deny",
      "wget *": "deny",
      "*Invoke-WebRequest*": "deny",
      "*Invoke-RestMethod*": "deny",
      "iwr *": "deny",
      "irm *": "deny",
      "git clone*": "deny",
      "git fetch*": "deny",
      "git pull*": "deny",
      "git push*": "deny",
      "git remote*": "deny",
      "git submodule*": "deny",
      "git ls-remote*": "deny",
      "pip install*": "deny",
      "pip3 install*": "deny",
      "pip download*": "deny",
      "*-m pip install*": "deny",
      "*-m pip download*": "deny",
      "uv *": "deny",
      "conda install*": "deny",
      "conda create*": "deny",
      "mamba install*": "deny",
      "npm *": "deny",
      "npx *": "deny",
      "pnpm *": "deny",
      "yarn *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sftp *": "deny",
      "ftp *": "deny",
      "nc *": "deny",
      "ncat *": "deny",
      "telnet *": "deny",
      "rsync *": "deny",
      "aria2c *": "deny",
      "gdown *": "deny",
      "kaggle *": "deny",
      "wandb *": "deny",
      "*http://*": "deny",
      "*https://*": "deny",
      "*/dev/tcp/*": "deny",
      "*requests*": "deny",
      "*httpx*": "deny",
      "*urllib*": "deny",
      "*aiohttp*": "deny",
      "*socket*": "deny",
      "*huggingface_hub*": "deny",
      "*hf_hub_download*": "deny",
      "*snapshot_download*": "deny",
      "*torch.hub*": "deny",
      "opencode *": "deny",
      "claude *": "deny",
      "taskkill*": "deny",
      "pkill *": "deny",
      "killall *": "deny",
      "kill *": "deny",
      "*Stop-Process*": "deny"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "skill": "deny",
    "lsp": "deny",
    "question": "deny",
    "doom_loop": "deny",
    "external_directory": "deny"
  }
}
